# appq connection — read-only access is sufficient. This agent never calls
# an appq write tool, including on enrich_project_context: its own
# read-only gate refuses that tool's action=write mode unconditionally,
# regardless of what appq:runman's own prompt instructs at the end of a
# pass (see README.md's Safety section).
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# Set exactly one LLM provider — checked in this order, first configured
# wins: Anthropic, OpenAI, DeepSeek, GLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override — no executor/validator split here (one role).
ANTHROPIC_MODEL=
OPENAI_MODEL=
ANTHROPIC_MAX_TOKENS=8192
OPENAI_MAX_OUTPUT_TOKENS=8192

# DeepSeek and Zhipu's GLM — both OpenAI Chat Completions-compatible, routed
# through the same generic adapter. Unlike Anthropic/OpenAI, there is no
# built-in default model here — DEEPSEEK_MODEL/GLM_MODEL are REQUIRED when
# that provider is selected (model IDs on both move fast; a silently stale
# hardcoded default would be worse than an explicit startup error). Base
# URLs default to the public endpoints — override only for a proxy/self-host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MAX_TOKENS=8192
# Note: this agent genuinely drives a browser (see src/tools/, PlaywrightBrowserTools
# from @appliqation/agent-core) and browser_take_screenshot results are attached to
# the model's messages as real images (LlmMessage.images) — appq:runman's evidence
# discipline depends on the model actually seeing the page. DeepSeek's chat models
# are text-only as of their public docs, so DEEPSEEK_API_KEY is not usable for this
# agent at all. GLM has vision-capable variants (the GLM-4V family) but not every
# GLM model does — GLM_MODEL must be explicitly set to a vision-capable model, not
# just any GLM chat model, or screenshot-dependent findings will silently degrade.

# appq:runman's own self-regulated budget — what the model is actually told
# to respect. Defaults match the workflow's own (RunmanPrompt.php).
EXPLORE_MAX_STEPS=50
EXPLORE_MAX_PAGES=12
EXPLORE_MAX_MINUTES=15

# A code-enforced backstop in case the model doesn't honor the limits
# above — set generously above them, not equal to them.
BUDGET_MAX_CALLS=150
BUDGET_MAX_PAGES=40
BUDGET_MAX_MILLIS=1500000
BUDGET_MAX_TURNS=80
# Broad backstop against runaway spend, not a tuned budget (the caps above
# normally end a run first) — total tokens across the whole run, cache included.
BUDGET_MAX_TOTAL_TOKENS=2000000

EVIDENCE_RING_BUFFER_CAP=500

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
